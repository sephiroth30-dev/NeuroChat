{
  "name": "neurochat",
  "version": "1.1.0-beta.7",
  "description": "Mensajería interna LAN para Neurofit",
  "main": "src/main/index.js",
  "author": "Neurofit",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "build": "electron-builder --win && electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win && electron-builder --mac",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html,json}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags",
    "release:upload": "bash scripts/release-github.sh"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.57.1",
    "jest": "^30.4.2",
    "prettier": "^3.8.3"
  }
}
